# ─────────────────────────────────────────────────────────────
# Copy to .env for local development. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

AWS_REGION=us-east-1
USERS_TABLE=dreamforge-users

# REQUIRED. Minimum 32 characters — the server refuses to boot without it.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# In AWS this belongs in Secrets Manager or an SSM SecureString parameter,
# NOT in the SAM template and NOT in a plain Lambda environment variable.
JWT_SECRET=dev-replace-me-with-at-least-32-random-characters

# Bearer tokens are short-lived because they live in browser storage.
JWT_EXPIRES_IN=2h

# bcrypt work factor. 12 is the target; 10 is the OWASP floor.
# Run `npm run bench:bcrypt` to see what this costs on your hardware.
BCRYPT_COST=12

# Exact origins allowed to call this API. Comma separated, no wildcards.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
