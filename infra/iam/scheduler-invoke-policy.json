{
  "_comment": [
    "EventBridge Scheduler role. This is the identity that actually starts the",
    "agent every morning — the autonomy trigger. Attach to",
    "dreamforge-scheduler-invoke, trusted by scheduler.amazonaws.com",
    "(trust-scheduler.json).",
    "",
    "It can do exactly one thing: invoke the agent function. Nothing else."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeAgentOnSchedule",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:dreamforge-agent",
        "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:dreamforge-agent:*"
      ]
    }
  ]
}
