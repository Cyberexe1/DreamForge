{
  "_comment": [
    "The capability gap that blocked deploying the agent. Attach to the",
    "DreamForge deploy user as DreamForgeDeployAgent.",
    "",
    "Every statement is scoped to dreamforge-* resources, and iam:PassRole is",
    "fenced to the two services that legitimately need it. That matters: an",
    "unrestricted iam:CreateRole plus iam:AttachRolePolicy lets the holder grant",
    "itself AdministratorAccess, so this is the difference between a deploy",
    "credential and an account-takeover credential.",
    "",
    "Remove this policy once the stack is stable — it is only needed while roles",
    "are being created."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProjectRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::961308088417:role/dreamforge-*"
    },
    {
      "Sid": "AttachOnlyTheLambdaLoggingPolicy",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::961308088417:role/dreamforge-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassProjectRolesToNamedServicesOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::961308088417:role/dreamforge-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": ["lambda.amazonaws.com", "scheduler.amazonaws.com"]
        }
      }
    },
    {
      "_note": [
        "App Runner's CreateService does not populate the iam:PassedToService",
        "context key, so a condition on it can never match and PassRole is",
        "always denied. These two ARNs are therefore listed unconditionally.",
        "",
        "The blast radius is small by construction: both roles' trust policies",
        "only permit apprunner service principals, so nothing else can assume",
        "them even if the pass were misused."
      ],
      "Sid": "PassAppRunnerRolesUnconditionally",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::961308088417:role/dreamforge-apprunner-instance",
        "arn:aws:iam::961308088417:role/dreamforge-apprunner-access"
      ]
    },
    {
      "Sid": "DeadLetterQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:TagQueue"
      ],
      "Resource": "arn:aws:sqs:us-east-1:961308088417:dreamforge-*"
    }
  ]
}
