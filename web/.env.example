# Public CloudFront domain serving /data/*.json and /images/*.png
# From the SAM stack output: DistributionDomain
VITE_DATA_BASE=https://dxxxxxxxxxxxxx.cloudfront.net

# Shown on the header button and in the footer
VITE_REPO_URL=https://github.com/your-user/creative-pulse

# Local development only. Renders the fixture in src/mock.ts so the UI can be
# built before the agent's first run. Ignored in production builds.
VITE_USE_MOCK=false
